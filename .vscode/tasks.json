{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build Raylib Game",
            "command": "clang++",
            "args": [
                "-std=c++17",
                "${file}",
                "-I${workspaceFolder}/raylib/src",
                "${workspaceFolder}/raylib/src/libraylib.a",
                "-framework", "OpenGL",
                "-framework", "Cocoa",
                "-framework", "IOKit",
                "-framework", "CoreVideo",
                "-framework", "QuartzCore",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
